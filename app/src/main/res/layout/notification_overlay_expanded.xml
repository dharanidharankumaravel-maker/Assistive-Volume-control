<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/notification_icon_expanded"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_notification"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/notification_title_expanded"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notification_title"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <TextView
                android:id="@+id/notification_subtitle_expanded"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Floating controls active"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/btn_notification_stop"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minHeight="34dp"
            android:text="@string/notification_action_stop"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorPrimary"
            android:background="@drawable/bg_notification_stop_btn"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_notification_toggle_expanded"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minWidth="68dp"
            android:minHeight="34dp"
            android:text="Hide"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_notification_action_btn"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />
    </LinearLayout>

</LinearLayout>

